{
  "name": "tailwatch-analytics",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:check": "pnpm --filter @tailwatch/infra ch:check",
    "db:clickhouse": "pnpm --filter @tailwatch/infra ch:apply",
    "db:clickhouse:reset": "pnpm --filter @tailwatch/infra ch:reset",
    "db:clickhouse:user": "pnpm --filter @tailwatch/infra ch:user",
    "db:mongo": "pnpm --filter @tailwatch/infra mongo:apply",
    "verify:mongo": "pnpm --filter @tailwatch/infra mongo:verify",
    "e2e:collector": "pnpm --filter @tailwatch/collector e2e",
    "live:consumer": "pnpm --filter @tailwatch/consumer live",
    "e2e:consumer": "pnpm --filter @tailwatch/consumer e2e",
    "verify:stages": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:mongo && pnpm db:check && pnpm e2e:collector && pnpm live:consumer && pnpm e2e:consumer"
  }
}
