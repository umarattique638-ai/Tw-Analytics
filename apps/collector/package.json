{
  "name": "@tailwatch/collector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"test/e2e/**\"",
    "build": "wrangler deploy --dry-run --outdir dist",
    "e2e": "wrangler deploy --dry-run --outdir dist && vitest run test/e2e"
  },
  "dependencies": {
    "@tailwatch/contract": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "miniflare": "5.20261006.0-alpha",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.148.0"
  }
}
