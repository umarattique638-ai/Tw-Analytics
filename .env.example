# Copy this file to .env (same folder) and fill it in. .env is git-ignored: never commit it, never paste it in chat.
# A value containing # must be in double quotes (TW_CH_PASSWORD="a#b"): an unquoted # starts a comment.

# ClickHouse Cloud: SQL console -> "Connect" -> HTTPS. An admin user (default) that may create databases
# and users. The tests create throwaway databases (tw_stage3_*, tw_e2e_*) and drop them again.
TW_CH_URL=https://YOUR-SERVICE.REGION.aws.clickhouse.cloud:8443
TW_CH_USER=default
TW_CH_PASSWORD=

# Only for `pnpm db:clickhouse:user` (creates tw_insert for the deployed consumer). Cloud password policy:
# 12+ characters with upper case, lower case, a digit and a special character.
TW_CH_INSERT_PASSWORD=

# Your local MongoDB. From Stage 5 it must be the single-node replica set rs0 (docs/TESTING.md section 8).
TW_MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0

# ---------------------------------------------------------------- Stage 5: the API (pnpm app)
# Public address of your deployed collector: goes into every snippet the dashboard shows.
TW_COLLECTOR_URL=https://tailwatch-collector.YOUR-SUBDOMAIN.workers.dev
# "KV sync on write": the API writes each site into the collector's KV through Cloudflare's REST API.
# Account ID: `npx wrangler whoami`. Namespace ID: apps/collector/wrangler.toml (SITE_CONFIG).
# Token: Cloudflare dashboard > My Profile > API Tokens > Create Custom Token, permission
# Account / Workers KV Storage / Edit. Free. Never commit it, never paste it in chat.
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=
# Read-only ClickHouse user for the verifier's "first pageview" check: `pnpm db:clickhouse:reader` creates it
# with this password (same policy as TW_CH_INSERT_PASSWORD).
TW_CH_READ_USER=tw_read
TW_CH_READ_PASSWORD=
# Optional: TW_API_PORT=8788

# ---------------------------------------------------------------- Online dashboard (Render + MongoDB Atlas)
# Only needed on YOUR computer for the one-time copy of accounts/sites to Atlas: pnpm db:mongo:copy
# (Atlas > your cluster > Connect > Drivers). Quote it if the password contains #.
TW_MONGO_TARGET_URL=
# On the server (Render > Environment), not here: TW_SIGNUP_ALLOWLIST=you@example.com
# A public (https) server refuses to start without it: until Phase 3 nobody else may sign up.

# ---------------------------------------------------------------- E-mail (forgot password)
# Free: Brevo (brevo.com > SMTP & API > API keys; 300 e-mails a day, no card). Add your sender address in
# Brevo > Senders first (a Gmail address works). On Vercel put both in Settings > Environment Variables.
# Without them: locally the reset e-mail is printed in the terminal; online, reset says "not set up".
TW_MAIL_FROM="TailWatch <you@gmail.com>"
TW_BREVO_API_KEY=
# Or Resend (needs your own domain to send to other people): TW_RESEND_API_KEY=

# ---------------------------------------------------------------- Daily KV reconcile (Vercel Cron)
# Any long random string (16+ characters). Put it in Vercel > Settings > Environment Variables as CRON_SECRET:
# Vercel then calls /api/v1/internal/reconcile once a day with it. Without it that route answers 404.
CRON_SECRET=
