{
  "title": "TailWatch MongoDB control-plane contract v1",
  "description": "Stage 1 document shapes. Runtime validators are materialized by 001_control_plane.js.",
  "database": "tailwatch_control",
  "collections": {
    "counters": {
      "document": {
        "bsonType": "object",
        "required": [
          "_id",
          "value"
        ],
        "properties": {
          "_id": {
            "bsonType": "string"
          },
          "value": {
            "bsonType": "long",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "tenants": {
      "document": {
        "bsonType": "object",
        "required": [
          "_id",
          "createdAt",
          "status",
          "plan",
          "region"
        ],
        "properties": {
          "_id": {
            "bsonType": "objectId"
          },
          "createdAt": {
            "bsonType": "date"
          },
          "updatedAt": {
            "bsonType": "date"
          },
          "status": {
            "enum": [
              "active",
              "suspended",
              "deleted"
            ]
          },
          "plan": {
            "bsonType": "string"
          },
          "region": {
            "enum": [
              "in",
              "in-eu"
            ]
          },
          "billing": {
            "bsonType": "object",
            "properties": {
              "customerId": {
                "bsonType": "string"
              },
              "subscriptionId": {
                "bsonType": "string"
              }
            },
            "additionalProperties": false
          },
          "settings": {
            "bsonType": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "users": {
      "document": {
        "bsonType": "object",
        "required": [
          "_id",
          "email",
          "emailNormalized",
          "createdAt",
          "status"
        ],
        "properties": {
          "_id": {
            "bsonType": "objectId"
          },
          "email": {
            "bsonType": "string",
            "minLength": 3,
            "maxLength": 320
          },
          "emailNormalized": {
            "bsonType": "string",
            "minLength": 3,
            "maxLength": 320
          },
          "name": {
            "bsonType": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "passwordHash": {
            "bsonType": "string",
            "maxLength": 512
          },
          "oauth": {
            "bsonType": "object"
          },
          "createdAt": {
            "bsonType": "date"
          },
          "updatedAt": {
            "bsonType": "date"
          },
          "status": {
            "enum": [
              "active",
              "disabled",
              "deleted"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "memberships": {
      "document": {
        "bsonType": "object",
        "required": [
          "_id",
          "tenantId",
          "userId",
          "role",
          "createdAt"
        ],
        "properties": {
          "_id": {
            "bsonType": "objectId"
          },
          "tenantId": {
            "bsonType": "objectId"
          },
          "userId": {
            "bsonType": "objectId"
          },
          "role": {
            "enum": [
              "owner",
              "admin",
              "viewer"
            ]
          },
          "createdAt": {
            "bsonType": "date"
          }
        },
        "additionalProperties": false
      }
    },
    "sites": {
      "document": {
        "bsonType": "object",
        "required": [
          "_id",
          "tenantId",
          "domain",
          "timezone",
          "allowedHosts",
          "retentionDays",
          "status",
          "region",
          "keys",
          "identitySecret",
          "createdAt"
        ],
        "properties": {
          "_id": {
            "bsonType": [
              "long",
              "int"
            ],
            "minimum": 1
          },
          "tenantId": {
            "bsonType": "objectId"
          },
          "domain": {
            "bsonType": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "timezone": {
            "bsonType": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "IANA timezone name. Stored in MongoDB; query/reporting layer applies it to UTC timestamps."
          },
          "allowedHosts": {
            "bsonType": "array",
            "minItems": 1,
            "items": {
              "bsonType": "string",
              "maxLength": 253
            }
          },
          "retentionDays": {
            "bsonType": [
              "int",
              "long"
            ],
            "minimum": 1
          },
          "status": {
            "enum": [
              "active",
              "paused",
              "deleted"
            ]
          },
          "region": {
            "enum": [
              "in",
              "in-eu"
            ]
          },
          "verifiedAt": {
            "bsonType": [
              "date",
              "null"
            ]
          },
          "identitySecret": {
            "bsonType": "string",
            "minLength": 32,
            "maxLength": 128
          },
          "keys": {
            "bsonType": "array",
            "minItems": 1,
            "items": {
              "bsonType": "object",
              "required": [
                "id",
                "publicKey",
                "createdAt",
                "status"
              ],
              "properties": {
                "id": {
                  "bsonType": "string",
                  "maxLength": 64
                },
                "publicKey": {
                  "bsonType": "string",
                  "pattern": "^tw_pub_[A-Za-z0-9]{32}$"
                },
                "createdAt": {
                  "bsonType": "date"
                },
                "revokedAt": {
                  "bsonType": [
                    "date",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "active",
                    "revoked"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "createdAt": {
            "bsonType": "date"
          },
          "updatedAt": {
            "bsonType": "date"
          }
        },
        "additionalProperties": false
      }
    },
    "sessions": {
      "document": {
        "bsonType": "object",
        "required": [
          "_id",
          "userId",
          "createdAt",
          "expiresAt"
        ],
        "properties": {
          "_id": {
            "bsonType": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the session token. The token itself is only ever in the user's cookie."
          },
          "userId": {
            "bsonType": "objectId"
          },
          "createdAt": {
            "bsonType": "date"
          },
          "expiresAt": {
            "bsonType": "date"
          }
        },
        "additionalProperties": false
      }
    },
    "exports": {
      "document": {
        "bsonType": "object",
        "required": [
          "_id",
          "tenantId",
          "siteId",
          "range",
          "from",
          "to",
          "timezone",
          "filename",
          "rows",
          "bytes",
          "csv",
          "createdBy",
          "createdAt",
          "expiresAt"
        ],
        "properties": {
          "_id": {
            "bsonType": "objectId"
          },
          "tenantId": {
            "bsonType": "objectId"
          },
          "siteId": {
            "bsonType": [
              "long",
              "int"
            ]
          },
          "range": {
            "enum": [
              "today",
              "7d",
              "30d"
            ]
          },
          "from": {
            "bsonType": "string",
            "maxLength": 40
          },
          "to": {
            "bsonType": "string",
            "maxLength": 40
          },
          "timezone": {
            "bsonType": "string",
            "maxLength": 64
          },
          "filename": {
            "bsonType": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "rows": {
            "bsonType": "int",
            "minimum": 0
          },
          "bytes": {
            "bsonType": "int",
            "minimum": 0
          },
          "csv": {
            "bsonType": "string",
            "maxLength": 1000000,
            "description": "The CSV as downloaded (a few KB: one row per day or hour)."
          },
          "createdBy": {
            "bsonType": "objectId"
          },
          "createdAt": {
            "bsonType": "date"
          },
          "expiresAt": {
            "bsonType": "date",
            "description": "createdAt + 90 days. A TTL index deletes the report then."
          }
        },
        "additionalProperties": false
      }
    },
    "password_resets": {
      "document": {
        "bsonType": "object",
        "required": [
          "_id",
          "userId",
          "createdAt",
          "expiresAt",
          "usedAt"
        ],
        "properties": {
          "_id": {
            "bsonType": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the reset token. The token itself is only ever in the e-mailed link."
          },
          "userId": {
            "bsonType": "objectId"
          },
          "createdAt": {
            "bsonType": "date"
          },
          "expiresAt": {
            "bsonType": "date",
            "description": "One hour after createdAt. A TTL index deletes the document later."
          },
          "usedAt": {
            "bsonType": [
              "date",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "kv_outbox": {
      "document": {
        "bsonType": "object",
        "required": [
          "_id",
          "tenantId",
          "error",
          "attempts",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "bsonType": [
              "long",
              "int"
            ],
            "description": "Site id whose Cloudflare KV entries do not match MongoDB yet."
          },
          "tenantId": {
            "bsonType": "objectId"
          },
          "error": {
            "bsonType": "string",
            "maxLength": 500
          },
          "attempts": {
            "bsonType": "int",
            "minimum": 0
          },
          "createdAt": {
            "bsonType": "date"
          },
          "updatedAt": {
            "bsonType": "date"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "indexes": [
    {
      "collection": "users",
      "keys": {
        "emailNormalized": 1
      },
      "options": {
        "unique": true,
        "collation": {
          "locale": "en",
          "strength": 2
        }
      }
    },
    {
      "collection": "memberships",
      "keys": {
        "tenantId": 1,
        "userId": 1
      },
      "options": {
        "unique": true
      }
    },
    {
      "collection": "memberships",
      "keys": {
        "userId": 1,
        "tenantId": 1
      }
    },
    {
      "collection": "sites",
      "keys": {
        "keys.publicKey": 1
      },
      "options": {
        "unique": true
      }
    },
    {
      "collection": "sites",
      "keys": {
        "tenantId": 1,
        "domain": 1
      },
      "options": {
        "unique": true
      }
    },
    {
      "collection": "sites",
      "keys": {
        "tenantId": 1,
        "status": 1
      }
    },
    {
      "collection": "tenants",
      "keys": {
        "status": 1,
        "createdAt": -1
      }
    },
    {
      "collection": "sessions",
      "keys": {
        "expiresAt": 1
      },
      "options": {
        "expireAfterSeconds": 0
      }
    },
    {
      "collection": "sessions",
      "keys": {
        "userId": 1
      }
    },
    {
      "collection": "exports",
      "keys": {
        "tenantId": 1,
        "siteId": 1,
        "createdAt": -1
      }
    },
    {
      "collection": "exports",
      "keys": {
        "expiresAt": 1
      },
      "options": {
        "expireAfterSeconds": 0
      }
    },
    {
      "collection": "password_resets",
      "keys": {
        "expiresAt": 1
      },
      "options": {
        "expireAfterSeconds": 0
      }
    },
    {
      "collection": "password_resets",
      "keys": {
        "userId": 1
      }
    },
    {
      "collection": "kv_outbox",
      "keys": {
        "tenantId": 1
      }
    }
  ]
}
